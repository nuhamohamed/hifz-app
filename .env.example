# Copy to .env and fill in. .env is gitignored and must not be committed.
# Both values come from the Supabase dashboard: Project Settings -> API.
#
# The anon key is public by design. It ships inside the app bundle and anyone
# who installs Dawrah can read it. Row level security is what protects the
# data, not the secrecy of this key.
#
# The Speechmatics API key is deliberately NOT here. It is a server secret on
# the speechmatics-token edge function, because anything in this file is
# compiled into the app and readable by anyone who installs it.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
