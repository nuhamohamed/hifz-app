{
  "expo": {
    "name": "HifzApp",
    "slug": "HifzApp",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "This app records audio to test Quran memorization transcription."
      },
      "bundleIdentifier": "com.anonymous.HifzApp"
    },
    "android": {
      "permissions": [
        "RECORD_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "@siteed/audio-studio",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#1A3D8A"
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sqlite",
      "expo-asset",
      "expo-font",
      "expo-web-browser"
    ]
  }
}
